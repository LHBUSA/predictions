{
  // PropBetEdge Predictions engine (owner-approved Worker name, 2026-10-03). One Worker, modular source.
  "name": "pbe-predictions",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // social cards: bundled Inter fonts + card background as binary Data modules (src/og.js)
  "rules": [{ "type": "Data", "globs": ["**/*.ttf", "**/*.jpg"], "fallthrough": true }],
  // Lanes dispatched by cron identity (src/engine-runs.js CRONS; test/engine-runs.test.js keeps these in sync):
  // "* * * * *" FAST (hot lane, intraday, BTC SHADOW) · "*/2 * * * *" CORE engine · every 5 min at :01/:06/... NEWSROOM
  "triggers": { "crons": ["*/2 * * * *", "* * * * *", "1,6,11,16,21,26,31,36,41,46,51,56 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Canonical market layer: every Kalshi read goes through propsports-markets (signed, shared backoff).
  "services": [{ "binding": "MARKETS", "service": "propsports-markets" }, { "binding": "AUTH", "service": "propbetedge-auth-magic" }],
  // AUTH: network membership authority (GET /membership?product=predictions); Predictions is All-Access-only
  "vars": {
    "SUPABASE_URL": "https://tkmlnhmylqnttmnsnief.supabase.co",
    "WEATHER_SERIES": "KXRAIN,KXHIGHNY,KXHIGHMIA,KXHIGHCHI,KXHIGHLAX,KXHIGHAUS,KXHIGHDEN,KXHIGHPHIL",
    // macro: Fed decision (SHADOW model; stored, not served publicly)
    "MACRO_SERIES": "KXFEDDECISION",
    // rates: Treasury par-yield path contracts (RESEARCH model)
    "RATES_SERIES": "KX10YRDIRHM,KX10YRDIRLM,KX5YRDIRHM,KX5YRDIRLM,KX7YRDIRLM,KX30YRDIRLM,KX10YRDIRHW,KX10YRDIRLW",
    // market monitoring only (no PBE model yet; Amazon settles on a commercial dataset)
    "MONITOR_SERIES": "KXTESLADELIVERYBY,KXAMZN,KXSPACEXCOUNT,KXSPACEXSTARSHIP,KXREACTOR,KXMEASLES,KXFLDENGUE,KXIPOANTHROPIC,KXIPOBREX",
    // cron writes only when "true" (requires sql/002 applied on tkmln)
    "ENGINE_ENABLED": "true",
    // Newsroom: AUTOMATIC publication of VALIDATED movers + resolution reports, checked every 5 minutes against the latest core run
    // (owner 2026-10-04). Kill switch: set NEWSROOM_AUTO_PUBLISH to anything but "true". Manual admin route kept for emergencies.
    "NEWSROOM_AUTO_PUBLISH": "true",
    // HOT lane on the one-minute wake-up: exact-station ASOS observations for active weather windows (immutable source
    // facts, new rows only), intraday recompute only on new inputs. Kill switch: anything but "true".
    "HOT_LANE": "true",
    // live intraday forecasts on new observations: maxtemp-intraday v2.1.0 (with the official METAR 6-hour maximum) +
    // precip-intraday v2.0.0, both validated RESEARCH. Kill switch: anything but "true".
    "INTRADAY_LIVE": "true",
    "NEWSROOM_MANUAL_PUBLISH": "true",
    // persist cycle skip diagnostics to pred_cycle_diagnostics (sql/003 applied 2026-10-03 23:30Z)
    "NEWSROOM_DB": "true",
    // decision ledger: write pred_decisions rows at designation time (sql/006 applied 2026-10-04, ledger 20261004140000)
    "DECISIONS_DB": "true",
    // sql/011 run ledger + atomic core/newsroom lease (Phases 2-3). Anything but "true" = run lanes without lease/heartbeat.
    "ENGINE_RUNS": "true",
    // intraday scoring (designation-intraday/1, sql/013 applied 2026-10-07): :04/:34 lane, writes pred_intraday_* only.
    // Kill switch: anything but "true" (tables stay; designations/scores are re-derivable from the ledger by rule).
    "INTRADAY_SCORING": "true",
    // maxtemp-intraday 2.2.0 PRIVATE SHADOW forward lane (sql/014 pred_forecasts_shadow). Never public, never a market input.
    // Kill switch: anything but "true" (v2.1 is unaffected either way).
    "INTRADAY_SHADOW_V22": "true",
    // CPI V1 PRIVATE SHADOW lane (sql/015): KXCPI / KXCPIYOY / KXCPICOREYOY forecasts to pred_forecasts_shadow +
    // pred_cpi_shadow_runs, EIA/BLS first-seen capture. Never public, never a market input. Kill switch: anything but "true".
    "CPI_SHADOW": "true",
    "CRYPTO_SHADOW": "true",
    "CRYPTO_SETTLEMENTS": "true",
    // PBE Signal 10 paper account (issue #52, sql/016 applied 2026-10-09): OPEN fills / EOD freeze / 5-min marks on the
    // one-minute cron. SIMULATED ONLY, no brokerage. Kill switch: anything but "true". SIGNAL10_START = first eligible EOD.
    "SIGNAL10": "true",
    "SIGNAL10_START": "2026-10-09",
    // PBE Market Tape (market-tape/1, issues #54/#56). Prices need BOTH MARKET_TAPE_QUOTES="on" AND a provider whose RIGHTS
    // record in src/market-tape/contract.js permits the audience (a paywall is NOT redistribution permission). ON with
    // iex-hist = PUBLIC + PAID display of IEX next-day (T+1) last sales with the IEX credit line (IEX policy §15). Yahoo has
    // no rights and is never displayed. Turning this "off" removes every price for every audience (no other change).
    "MARKET_TAPE_QUOTES": "on",
    // iex-hist = IEX Historical Data (TOPS, T+1): exchange-originated, display permitted to public + paid with the IEX credit
    // line (contract.js rights record). Served from our own snapshot in pred_source_observations, never per request.
    "MARKET_TAPE_PROVIDER": "iex-hist",
    // first-party collector (IEX HIST -> pred_source_observations): resumable steps (sql/017 checkpoints, ~1.5 GiB of
    // decompressed pcapng per step, ~10-15 s CPU) every minute 03:30-13:29 UTC on the FAST cron; ~25 steps per session.
    // Kill switch: anything but "true" (a running job simply pauses at its last checkpoint).
    "IEX_HIST_COLLECTOR": "true"
  }
  // secrets: SUPABASE_SERVICE_KEY (tkmln service role), MARKETS_READ_TOKEN (propsports-markets admin read), ADMIN_TOKEN,
  // DIAGNOSTICS_TOKEN (read-only GET /admin/intraday/scores + /admin/intraday/shadow-compare),
  // ROBINHOOD_CRYPTO_API_KEY + ROBINHOOD_CRYPTO_PRIVATE_KEY_B64 (read-only crypto market-data authentication; no trading endpoints wired)
}
