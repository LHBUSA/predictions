{
  "name": "pbe-predictions-collector-housing-signals",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "services": [
    { "binding": "SOURCE_MACRO", "service": "pbe-predictions-source-macro" },
    { "binding": "SOURCE_ZORI", "service": "pbe-predictions-source-zori" },
    { "binding": "SOURCE_PERMITS", "service": "pbe-predictions-source-permits" },
    { "binding": "LEDGER", "service": "pbe-predictions-ledger" }
  ],
  "triggers": {
    "crons": ["30 14 * * *"]
  }
}
